# Frontend Environment Variables

# Backend API URL - leave unset/empty for local Docker Compose (nginx
# proxies /api/... to the backend on the same origin). Only set this when
# the frontend and backend are deployed on different origins/domains (e.g.
# frontend on Vercel, backend on Render) - axios prefixes every API call
# with it. Example: VITE_API_URL=https://your-backend.onrender.com
VITE_API_URL=

# Optional: Enable debug mode
VITE_DEBUG=false
