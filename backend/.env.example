# ============================================
# FileShield - Environment Configuration
# Copy this file to .env and fill in your values
# ============================================

# ============================================
# DATABASE CONFIGURATION
# ============================================

# SQLite (Development - RECOMMENDED FOR START)
DATABASE_URL=sqlite+aiosqlite:///./fileshield.db

# PostgreSQL (Production - uncomment when ready)
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/fileshield

# ============================================
# REDIS & CELERY
# ============================================

REDIS_URL=redis://localhost:6379
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ============================================
# SECURITY & AUTHENTICATION
# ============================================

# JWT Secret Key - REQUIRED
# Generate with: openssl rand -hex 32
# OR: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=GENERATE_THIS_WITH_OPENSSL_RAND_HEX_32

# Token expiration
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Algorithm for JWT
ALGORITHM=HS256

# ============================================
# GOOGLE OAUTH (OPTIONAL)
# ============================================

# Get these from: https://console.cloud.google.com/
# Leave as NOT_CONFIGURED_OPTIONAL to disable Google OAuth
GOOGLE_CLIENT_ID=NOT_CONFIGURED_OPTIONAL
GOOGLE_CLIENT_SECRET=NOT_CONFIGURED_OPTIONAL

# ============================================
# SUPER ADMIN ACCOUNT
# ============================================

# Default super admin credentials
# CHANGE IMMEDIATELY AFTER FIRST LOGIN!
SUPER_ADMIN_EMAIL=admin@fileshield.com
SUPER_ADMIN_PASSWORD=ChangeThisPassword123!

# ============================================
# FILE UPLOAD SETTINGS
# ============================================

# Maximum file size (in bytes)
# Current: 50 MB
MAX_FILE_SIZE=52428800

# Upload directory (local storage)
UPLOAD_DIR=./uploads

# ============================================
# CORS SETTINGS
# ============================================

# Allowed origins (JSON array format)
CORS_ORIGINS=["http://localhost:5173","http://localhost:8000","http://127.0.0.1:5173","http://localhost"]

# ============================================
# FEATURES
# ============================================

# Enable PDF report generation
WEASYPRINT_ENABLED=true

# YARA rules directory
YARA_RULES_DIR=./yara_rules

# ============================================
# PRODUCTION SETTINGS (when deploying)
# ============================================

# Update these for production:
# - DATABASE_URL to production PostgreSQL
# - REDIS_URL to production Redis
# - SECRET_KEY to new random value
# - CORS_ORIGINS to production frontend URL
# - Set GOOGLE_CLIENT_ID/SECRET (optional)
# - Change SUPER_ADMIN credentials
